#!/usr/bin/env python3
"""Forward local keystrokes to the RPi's virtual keyboard via ydotool.

Run this after SSH-ing into the device. Every key you press is forwarded
to ydotoold's virtual keyboard, behaving exactly as if a USB keyboard were
plugged into the RPi. Press Ctrl+] to exit and return to the shell.

Holding a key down (e.g. flint's "long-press Esc to exit") is detected via
the local terminal's own key-repeat: holding a key makes the terminal send
the same character repeatedly, which we use as a proxy for "still held" and
turn into a single sustained key-down/key-up pair instead of a rapid string
of independent taps — see run() for the timing logic.
"""
import curses
import os
import subprocess
import sys
import time

EXIT_KEY = "\x1d"  # Ctrl+]

# If no repeat of the currently-held key arrives within this window, treat it
# as released. Must be longer than typical terminal key-repeat gaps (usually
# well under 100ms once repeating) but short enough that a single tap doesn't
# feel delayed.
RELEASE_TIMEOUT_MS = 150

# ydotoold (see stage-flint/files/ydotoold.service) is pinned to this socket
# path explicitly. The ydotool client falls back to $XDG_RUNTIME_DIR, which an
# SSH login session normally has set — pin it here too so client and daemon
# always agree regardless of the invoking session's environment.
YDOTOOL_ENV = {**os.environ, "YDOTOOL_SOCKET": "/tmp/.ydotool_socket"}

# Linux input-event-codes (linux/input-event-codes.h) for keys curses reports
# as KEY_* int constants rather than printable characters.
SPECIAL_KEYS = {
    curses.KEY_UP: 103,
    curses.KEY_DOWN: 108,
    curses.KEY_LEFT: 105,
    curses.KEY_RIGHT: 106,
    curses.KEY_HOME: 102,
    curses.KEY_END: 107,
    curses.KEY_PPAGE: 104,  # Page Up
    curses.KEY_NPAGE: 109,  # Page Down
    curses.KEY_DC: 111,     # Delete
    curses.KEY_BACKSPACE: 14,
    curses.KEY_ENTER: 28,
}

# Control characters curses reports as plain one-character strings rather
# than KEY_* constants.
CONTROL_KEYS = {
    "\n": 28,    # Enter
    "\r": 28,    # Enter
    "\x7f": 14,  # Backspace (many terminals send DEL for Backspace)
    "\x08": 14,  # Backspace (BS)
    "\t": 15,    # Tab
    "\x1b": 1,   # Esc
}


def send_key_event(code, value):
    subprocess.run(
        ["ydotool", "key", f"{code}:{value}"],
        env=YDOTOOL_ENV, check=True,
    )


def send_text(text):
    subprocess.run(["ydotool", "type", "--", text], env=YDOTOOL_ENV, check=True)


def check_ydotool_available():
    try:
        subprocess.run(
            ["ydotool", "key", "0:0"],
            env=YDOTOOL_ENV, capture_output=True, check=True,
        )
    except FileNotFoundError:
        sys.exit("virtual-keyboard: 'ydotool' is not installed.")
    except subprocess.CalledProcessError as exc:
        stderr = exc.stderr.decode(errors="replace") if exc.stderr else ""
        sys.exit(
            "virtual-keyboard: ydotool could not reach ydotoold "
            f"(is the service running?). Details: {stderr.strip()}"
        )


def run(stdscr):
    curses.cbreak()
    curses.noecho()
    stdscr.keypad(True)
    stdscr.timeout(RELEASE_TIMEOUT_MS // 2)
    stdscr.addstr(0, 0, "virtual-keyboard active. Press Ctrl+] to exit.")
    stdscr.refresh()

    held_code = None
    held_last_seen = 0.0

    def release_held():
        nonlocal held_code
        if held_code is not None:
            send_key_event(held_code, 0)
            held_code = None

    while True:
        try:
            ch = stdscr.get_wch()
        except curses.error:
            # No input arrived within the poll window — if we're tracking a
            # held key and its repeat stream has gone quiet, it was released.
            if held_code is not None and (time.monotonic() - held_last_seen) * 1000 >= RELEASE_TIMEOUT_MS:
                release_held()
            continue

        if isinstance(ch, str) and ch == EXIT_KEY:
            release_held()
            break

        code = SPECIAL_KEYS.get(ch) if isinstance(ch, int) else CONTROL_KEYS.get(ch)

        if code is not None:
            if code == held_code:
                # Same code arriving again means the terminal is auto-repeating
                # because the local key is still held — extend the hold instead
                # of tapping again.
                held_last_seen = time.monotonic()
            else:
                release_held()
                send_key_event(code, 1)
                held_code = code
                held_last_seen = time.monotonic()
            continue

        if isinstance(ch, int):
            continue  # unmapped special key

        release_held()
        send_text(ch)


def main():
    check_ydotool_available()
    curses.wrapper(run)


if __name__ == "__main__":
    main()
