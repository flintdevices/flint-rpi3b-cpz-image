[Unit]
Description=flint early ST7789 panel console
# Route a text console onto the SPI panel as soon as it's available, long
# before APPLaunch (a lingered user service at the end of boot) renders to it,
# so the display isn't black for the whole boot. Ordered early but after the
# core filesystem/udev bring-up; the script itself waits for /dev/fb_lcd.
After=systemd-udev-trigger.service
Before=multi-user.target
ConditionPathExists=/usr/bin/con2fbmap

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/flint-panel-console.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
