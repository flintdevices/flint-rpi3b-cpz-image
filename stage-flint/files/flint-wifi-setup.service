[Unit]
Description=flint first-boot Wi-Fi configuration
After=network-pre.target NetworkManager.service
Wants=NetworkManager.service
# Deliberately NOT ordered Before=network.target: with real credentials this
# script polls/retries for up to ~30s, and network.target gates
# systemd-user-sessions -> user@UID -> APPLaunch (the panel). Ordering it before
# network.target put that wait directly on the boot-to-display path. It runs as
# a background oneshot after NetworkManager instead, so it never delays the
# display coming up.
ConditionPathExists=/boot/firmware/wifi.txt

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/flint-wifi-setup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
